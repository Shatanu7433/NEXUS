# ---------- Backend (backend/.env) ----------
APP_NAME="NEXUS API"
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO

# PostgreSQL + pgvector (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus

# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000"]

# Authentication abstraction: "dev" (single local user) | "github" (Phase 8)
AUTH_PROVIDER=dev
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI layer (used from Phase 3). Keys stay on the backend only.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# ---------- Frontend (frontend/.env.local) ----------
# Public by design: the backend URL only. Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000
